# 后端 API 地址（必填）
VITE_API_BASE_URL=http://your-backend-host:8080

# WPS 在线文档 SDK 地址（可选，不填则文档预览功能不可用）
VITE_WPS_SDK_URL=https://wwo.wps.cn/office-online/sdk/sdk.js

# AI 成长回顾 / 成长对比（§3.3 按需触发）
# provider: mock（默认，无需 key）| deepseek | qwen
# DeepSeek: https://platform.deepseek.com/api-docs
# 通义千问: https://help.aliyun.com/zh/dashscope/developer-reference/compatibility-of-openai-with-dashscope
VITE_AI_PROVIDER=mock
VITE_AI_API_KEY=
VITE_AI_BASE_URL=https://api.deepseek.com
VITE_AI_MODEL=deepseek-chat
