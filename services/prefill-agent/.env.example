# ── LLM Provider ──────────────────────────────────────────────────────────────
# deepseek (default) | qwen | openai | claude
LLM_PROVIDER=deepseek

# DeepSeek (default)
DEEPSEEK_API_KEY=sk-...

# Qwen / DashScope (set LLM_PROVIDER=qwen)
# DASHSCOPE_API_KEY=sk-...

# OpenAI (set LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Claude / Anthropic (set LLM_PROVIDER=claude, also pip install anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# Override the model name (optional, each provider has a sensible default)
# LLM_MODEL=deepseek-chat

# ── Service config ─────────────────────────────────────────────────────────────
# Maximum upload size in MB
MAX_FILE_MB=50

# Max characters per extraction chunk (~3 000 tokens for Chinese)
PREFILL_CHUNK_SIZE=8000
